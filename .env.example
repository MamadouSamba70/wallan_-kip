# Variables d'environnement — Projet WALLAN
# Copiez ce fichier en .env et remplissez les valeurs réelles
# Ne jamais committer le fichier .env sur GitHub !

# ============================================================
# DJANGO
# ============================================================
SECRET_KEY=votre-secret-key-django-ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# BASE DE DONNÉES POSTGRESQL
# ============================================================
DB_NAME=wallan_db
DB_USER=wallan_user
DB_PASSWORD=votre-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_TOKEN_LIFETIME=60        # minutes
JWT_REFRESH_TOKEN_LIFETIME=7        # jours

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# FIREBASE
# ============================================================
FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk.json
FIREBASE_PROJECT_ID=wallan-project

# ============================================================
# AFRICA'S TALKING (SMS)
# ============================================================
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=votre-api-key

# ============================================================
# EMAIL
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app

# ============================================================
# CELERY
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
